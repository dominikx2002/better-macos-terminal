# Package managers — MacPorts (/opt/local), Homebrew (Apple Silicon: /opt/homebrew, Intel: /usr/local)
[[ -d /opt/local/bin ]] && export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$PATH"
typeset -U path fpath  # usuń duplikaty
# Podpowiedzi (completions) z pakietów MacPorts
[[ -d /opt/local/share/zsh/site-functions ]] && fpath=(/opt/local/share/zsh/site-functions $fpath)

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_all_dups hist_ignore_space share_history

# Shell
setopt autocd interactivecomments nonomatch promptsubst

# Autofill
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Git in prompt
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats ' %b'

# Kali start
PROMPT_EOL_MARK=''
prompt_symbol=@
PROMPT=$'\n%F{208}╭──%B%F{214}%n%b%F{231}'$prompt_symbol$'%B%F{214}%m%b %B%F{33}%(6~.%-1~/…/%4~.%5~)%b %F{yellow}${vcs_info_msg_0_}%F{208}\n╰─%B%F{231}$%b%F{reset} '

# Aliases
alias ls='ls -GF'
alias ll='ls -lGF'
alias la='ls -laGF'
alias grep='grep --color=auto'

# Extensions — szuka wtyczek we wszystkich prefiksach (bez wywoływania `brew --prefix`)
_plugin_prefixes=(/opt/local /opt/homebrew /usr/local)
_source_plugin() {
  local p
  for p in $_plugin_prefixes; do
    [[ -f "$p/share/$1/$1.zsh" ]] && { source "$p/share/$1/$1.zsh"; return; }
  done
}
_source_plugin zsh-autosuggestions
_source_plugin zsh-syntax-highlighting  # musi być ładowany jako ostatni
unset _plugin_prefixes; unfunction _source_plugin

# Autostart fastfetch — tylko w interaktywnej powłoce podłączonej do TTY
if [[ -o interactive ]] && [[ -t 1 ]] && [[ -x "$HOME/.config/fastfetch/launch.sh" ]]; then
  "$HOME/.config/fastfetch/launch.sh"
fi
